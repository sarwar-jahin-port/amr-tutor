# Copy this file to .env and fill in real values. Never commit .env.

# --- Shared / Database ---
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://amr_tutor:amr_tutor@localhost:5432/amr_tutor?schema=public"

# --- API (apps/api) ---
NODE_ENV="development"
PORT=4000
API_PREFIX="api/v1"
# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:3000"

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
