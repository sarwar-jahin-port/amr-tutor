# Copy this file to .env and fill in real values. Never commit .env.

# --- Shared / Database ---
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://amr_tutor:amr_tutor@localhost:5432/amr_tutor?schema=public"

# --- API (apps/api) ---
NODE_ENV="development"
PORT=4000
API_PREFIX="api/v1"
# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:3000"

# Secret used to sign short-lived access tokens (HS256). Must be at least
# 32 random characters. Generate one with: openssl rand -base64 48
# Never reuse this placeholder and never commit a real secret.
JWT_ACCESS_SECRET="CHANGE_ME_generate_a_real_random_secret_at_least_32_chars_long"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Optional overrides for the /auth/register and /auth/login rate limiter
# (default: 5 requests per 60000ms per IP). Leave unset for normal
# development and production use. Only export these (don't put them in a
# checked-in .env) when running the Playwright web e2e suite's critical-
# journey tests (apps/web/tests/e2e/journey-*.spec.ts) locally, since those
# legitimately register/log in several real accounts per run and would
# otherwise trip the limiter — e.g.
# AUTH_RATE_LIMIT_MAX=1000 AUTH_RATE_LIMIT_TTL_MS=60000 pnpm --filter api run start
# AUTH_RATE_LIMIT_TTL_MS=60000
# AUTH_RATE_LIMIT_MAX=1000

# Private object storage for verification evidence (blueprint Phase 10).
# 'local-emulator' runs an in-process S3-compatible server — nothing else
# to install for local dev. Switch to 's3' and set the EVIDENCE_S3_ENDPOINT/
# ACCESS_KEY_ID/SECRET_ACCESS_KEY below to point at real S3-compatible
# storage (AWS S3, DigitalOcean Spaces, MinIO, ...) in staging/production.
EVIDENCE_STORAGE_MODE="local-emulator"
EVIDENCE_S3_BUCKET="amr-tutor-verification-evidence"
EVIDENCE_S3_REGION="us-east-1"
# EVIDENCE_S3_ENDPOINT="https://..."
# EVIDENCE_S3_ACCESS_KEY_ID="..."
# EVIDENCE_S3_SECRET_ACCESS_KEY="..."
# EVIDENCE_S3_FORCE_PATH_STYLE=true

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
